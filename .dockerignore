# The build context is the patched lib/orca submodule and nothing else. Keep it
# lean: everything below is either irrelevant to packaging or would silently
# make the build depend on host state.
.git
.github
.cache
.pc
dist
docs
test
ci
!ci/build/electron-builder.overlay.cjs
patches
*.md
mise.toml

# The submodule's gitlink and any host-side install.
lib/orca/.git
**/node_modules
**/.DS_Store

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.mise/tasks/hooks/session-start.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.mise/tasks/hooks/gate-freshness.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.mise/tasks/hooks/graph-first.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__codebase-memory__index_repository",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.mise/tasks/hooks/index-owner.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

+describe('web resource manager', () => {
+  beforeEach(() => {
+    vi.resetModules()
+  })
+
+  afterEach(() => {
+    vi.unstubAllGlobals()
+  })
+
+  it('reports the runtime processes rather than the browser it runs in', async () => {
+    // Why: the Resource Manager exists to show terminals and agents, and in the tile
+    // those run on the server. A browser has no process table worth showing, so an
+    // unrouted panel renders all-zero rows that look like an idle host.
+    const runtimeCalls: string[] = []
+    vi.doMock('./web-runtime-client', () => ({
+      WebRuntimeClient: class {
+        call(method: string): Promise<RuntimeRpcResponse<unknown>> {
+          runtimeCalls.push(method)
+          return Promise.resolve({
+            id: 'call-1',
+            ok: true,
+            result: {
+              app: { cpu: 4, memory: 128, main: { cpu: 1, memory: 32 } },
+              worktrees: [{ worktreeId: 'w-1', cpu: 12, memory: 512 }],
+              host: { totalMemory: 2048, cpuCoreCount: 4 },
+              totalCpu: 16,
+              totalMemory: 640,
+              collectedAt: 99
+            },
+            _meta: { runtimeId: 'runtime-1' }
+          })
+        }
+
+        close(): void {}
+      }
+    }))
+
+    const globals = installBrowserGlobals('Linux')
+    writeStoredRuntimeEnvironment(globals.storage)
+    const { installWebPreloadApi } = await import('./web-preload-api')
+    installWebPreloadApi()
+
+    const snapshot = await globals.window.api.memory.getSnapshot()
+
+    expect(runtimeCalls).toContain('diagnostics.memory')
+    expect(snapshot.totalCpu).toBe(16)
+    expect(snapshot.worktrees).toHaveLength(1)
+    expect(snapshot.collectedAt).toBe(99)
+  })
+
+  it('falls back to an empty snapshot instead of throwing when the runtime cannot answer', async () => {
+    // Why: Resource Manager is a panel, not a gate — a disconnected server must render
+    // empty rows, never break the settings surface it lives on.
+    vi.doMock('./web-runtime-client', () => ({
+      WebRuntimeClient: class {
+        call(): Promise<RuntimeRpcResponse<unknown>> {
+          return Promise.reject(new Error('runtime unreachable'))
+        }
+
+        close(): void {}
+      }
+    }))
+
+    const globals = installBrowserGlobals('Linux')
+    writeStoredRuntimeEnvironment(globals.storage)
+    const { installWebPreloadApi } = await import('./web-preload-api')
+    installWebPreloadApi()
+
+    const snapshot = await globals.window.api.memory.getSnapshot()
+
+    expect(snapshot.totalCpu).toBe(0)
+    expect(snapshot.worktrees).toEqual([])
+  })
+})

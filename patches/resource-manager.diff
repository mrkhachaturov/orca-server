+describe('web resource manager', () => {
+  beforeEach(() => {
+    vi.resetModules()
+  })
+
+  afterEach(() => {
+    vi.unstubAllGlobals()
+  })
+
+  it('reports the runtime processes rather than the browser it runs in', async () => {
+    // Why: the Resource Manager exists to show terminals and agents, and in the tile
+    // those run on the server. A browser has no process table worth showing, so an
+    // unrouted panel renders all-zero rows that look like an idle host.
+    const runtimeCalls: string[] = []
+    vi.doMock('./web-runtime-client', () => ({
+      WebRuntimeClient: class {
+        call(method: string): Promise<RuntimeRpcResponse<unknown>> {
+          runtimeCalls.push(method)
+          return Promise.resolve({
+            id: 'call-1',
+            ok: true,
+            result: {
+              app: { cpu: 4, memory: 128, main: { cpu: 1, memory: 32 } },
+              worktrees: [{ worktreeId: 'w-1', cpu: 12, memory: 512 }],
+              host: { totalMemory: 2048, cpuCoreCount: 4 },
+              totalCpu: 16,
+              totalMemory: 640,
+              collectedAt: 99
+            },
+            _meta: { runtimeId: 'runtime-1' }
+          })
+        }
+
+        close(): void {}
+      }
+    }))
+
+    const globals = installBrowserGlobals('Linux')
+    writeStoredRuntimeEnvironment(globals.storage)
+    const { installWebPreloadApi } = await import('./web-preload-api')
+    installWebPreloadApi()
+
+    const snapshot = await globals.window.api.memory.getSnapshot()
+
+    expect(runtimeCalls).toContain('diagnostics.memory')
+    expect(snapshot.totalCpu).toBe(16)
+    expect(snapshot.worktrees).toHaveLength(1)
+    expect(snapshot.collectedAt).toBe(99)
+  })
+
+  it('renders an empty panel when no environment is connected', async () => {
+    // Why: Resource Manager is a panel, not a gate — with nothing paired there is no
+    // process table to ask for, and it must render empty rows rather than break the
+    // settings surface it lives on.
+    const runtimeCalls: string[] = []
+    vi.doMock('./web-runtime-client', () => ({
+      WebRuntimeClient: class {
+        call(method: string): Promise<RuntimeRpcResponse<unknown>> {
+          runtimeCalls.push(method)
+          return Promise.reject(new Error('should not be reached'))
+        }
+
+        close(): void {}
+      }
+    }))
+
+    const globals = installBrowserGlobals('Linux')
+    const { installWebPreloadApi } = await import('./web-preload-api')
+    installWebPreloadApi()
+
+    const snapshot = await globals.window.api.memory.getSnapshot()
+
+    expect(snapshot.totalCpu).toBe(0)
+    expect(snapshot.worktrees).toEqual([])
+    expect(runtimeCalls).toEqual([])
+  })
+
+  it('surfaces a failure from a connected runtime instead of reporting an idle host', async () => {
+    // Why: an empty snapshot is indistinguishable from a healthy host with nothing
+    // running. The pane derives `daemonUnreachable` from a REJECTION, so swallowing one
+    // makes the "daemon not responding / Restart" banner unreachable in the tile and
+    // renders an authorization failure as "nothing paired".
+    vi.doMock('./web-runtime-client', () => ({
+      WebRuntimeClient: class {
+        call(): Promise<RuntimeRpcResponse<unknown>> {
+          return Promise.reject(new Error('runtime unreachable'))
+        }
+
+        close(): void {}
+      }
+    }))
+
+    const globals = installBrowserGlobals('Linux')
+    writeStoredRuntimeEnvironment(globals.storage)
+    const { installWebPreloadApi } = await import('./web-preload-api')
+    installWebPreloadApi()
+
+    await expect(globals.window.api.memory.getSnapshot()).rejects.toThrow('runtime unreachable')
+  })
+
+  it('surfaces a refused call rather than rendering it as nothing paired', async () => {
+    // Why: a revoked device answers with an ok:false envelope rather than a transport
+    // failure. Reported as an empty snapshot it is byte-identical to a browser that was
+    // never paired, so the user sees an idle host instead of being told to re-pair.
+    vi.doMock('./web-runtime-client', () => ({
+      WebRuntimeClient: class {
+        call(): Promise<RuntimeRpcResponse<unknown>> {
+          return Promise.resolve({
+            id: 'call-1',
+            ok: false,
+            error: { code: 'unauthorized', message: 'device token revoked' }
+          })
+        }
+
+        close(): void {}
+      }
+    }))
+
+    const globals = installBrowserGlobals('Linux')
+    writeStoredRuntimeEnvironment(globals.storage)
+    const { installWebPreloadApi } = await import('./web-preload-api')
+    installWebPreloadApi()
+
+    await expect(globals.window.api.memory.getSnapshot()).rejects.toThrow('device token revoked')
+  })
+})

+  /** Cold-restore identity for a persisted pane, from THIS host's hook rows.
+   *
+   *  Why: the desktop reads `entry.agentType` / `entry.providerSession` off its renderer store to
+   *  decide a cold restore. Headless has no store; the same facts live in the agent-hooks cache,
+   *  hydrated from disk at startup, so they survive the restart that killed the agent. Returns null
+   *  unless the pane has a resumable agent AND a provider session to resume. */
+  private resolveHeadlessAgentColdRestore(tab: {
+    parentTabId: string
+    leafId: string
+  }): { agent: ResumableTuiAgent; providerSession: AgentProviderSessionMetadata } | null {
+    if (!isTerminalLeafId(tab.leafId) || tab.parentTabId.includes(':')) {
+      return null
+    }
+    const paneKey = makePaneKey(tab.parentTabId, tab.leafId)
+    // Why upstream's own accessors: v1.4.184 resolves provider-session rows per pane for
+    // exactly this reason — "hook rows are the only carrier of live agent state on a
+    // headless host" — so the identity we need is already indexed and disk-hydrated.
+    const rows =
+      this.getAgentProviderSessionRowsForPaneFn?.(paneKey) ??
+      indexAgentStatusRowsByPaneKey(this.getAgentProviderSessionSnapshotFn?.() ?? []).get(paneKey) ??
+      []
+    const row = this.getHookAgentRowForPane(rows)
+    const agent = row.providerSessionAgentType ?? row.agentType
+    if (!isResumableTuiAgent(agent)) {
+      return null
+    }
+    const providerSession = normalizeAgentProviderSession(row.providerSession)
+    return providerSession ? { agent, providerSession } : null
+  }

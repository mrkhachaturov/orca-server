+// Why: a headless-served pane exists only as a PTY record — no renderer publishes a leaf for it —
+// yet it carries the same pane identity and the same live titles orchestration delivery reads.
+// Projecting it lets the one delivery implementation serve both instead of the browser getting a
+// thinner copy.
+function ptyOrchestrationMailboxLeaf(
+  pty: RuntimePtyWorktreeRecord
+): OrchestrationMailboxLeaf | null {
+  const pane = parsePaneKey(pty.paneKey ?? '')
+  if (!pane) {
+    return null
+  }
+  return {
+    tabId: pane.tabId,
+    leafId: pane.leafId,
+    ptyId: pty.ptyId,
+    // Why connected and not a pane's `writable`: a PTY record has no renderer pane to be
+    // read-only, so the live process is the whole writability question.
+    writable: pty.connected,
+    lastAgentStatus: pty.lastAgentStatus,
+    lastAgentStatusObservedLive: pty.lastAgentStatusObservedLive,
+    lastOscTitle: pty.lastOscTitle,
+    paneTitle: pty.managementTitle ?? pty.title
+  }
+}

+  /** `getLeafKey` joins the pane's ids with `::`; a pane key joins the same pair with `:`. */
+  private paneKeyForLeafKey(leafKey: string): string {
+    const separator = leafKey.indexOf('::')
+    return separator < 0 ? leafKey : `${leafKey.slice(0, separator)}:${leafKey.slice(separator + 2)}`
+  }
+
+  // Why these three resolve the PTY record only after the graph misses: a desktop pane always has
+  // a leaf, so it keeps every answer it had, and delivery cannot reach one terminal twice.
+  private orchestrationMailboxLeafForLeafKey(leafKey: string): OrchestrationMailboxLeaf | undefined {
+    const leaf = this.leaves.get(leafKey)
+    if (leaf) {
+      return leaf
+    }
+    const pty = this.getPtyRecordForPaneKey(this.paneKeyForLeafKey(leafKey))
+    return (pty ? ptyOrchestrationMailboxLeaf(pty) : null) ?? undefined
+  }
+
+  private orchestrationMailboxHandleForLeafKey(leafKey: string): string | undefined {

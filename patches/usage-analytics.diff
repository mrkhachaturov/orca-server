+// Why: without these three keys the namespaces fell through to createFallbackProxy,
+// where every method resolves to undefined — so Stats & Usage stayed on "Not scanned
+// yet" and its enable buttons did nothing at all. The three desktop namespaces differ
+// only by channel prefix, so one factory carries the provider as a parameter rather
+// than repeating the same eight methods three times.
+// The overload mirrors upstream's own createUsageProviderApi: PreloadApi declares the
+// three namespaces as separate types, and the generic return is what lets one body
+// serve all three without asserting the result away.
+type UsageProviderApiKey = 'claudeUsage' | 'codexUsage' | 'openCodeUsage'
+type UsageRangeArgs = { scope: string; range: string }
+
+const USAGE_PROVIDER_BY_KEY = {
+  claudeUsage: 'claude',
+  codexUsage: 'codex',
+  openCodeUsage: 'openCode'
+} as const
+
+function createUsageApi<Key extends UsageProviderApiKey>(key: Key): PreloadApi[Key]
+function createUsageApi(key: UsageProviderApiKey): PreloadApi[UsageProviderApiKey] {
+  const provider = USAGE_PROVIDER_BY_KEY[key]
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any -- upstream's ipc.invoke
+  // is likewise `Promise<any>`; the wire contract is JSON and the runtime returns exactly
+  // what the desktop store returns.
+  const call = (method: string, params: Record<string, unknown> = {}): Promise<any> =>
+    callRuntimeResult<unknown>(`usage.${method}`, { provider, ...params })
+  return {
+    getScanState: () => call('getScanState'),
+    setEnabled: (args: { enabled: boolean }) => call('setEnabled', { enabled: args.enabled }),
+    // Why: `force` is optional on the desktop signature and the schema rejects unknown
+    // keys, so omit it entirely rather than sending an explicit undefined.
+    refresh: (args?: { force?: boolean }) =>
+      call('refresh', args?.force === undefined ? {} : { force: args.force }),
+    getSnapshot: (args: UsageRangeArgs & { limit?: number }) => call('getSnapshot', args),
+    getSummary: (args: UsageRangeArgs) => call('getSummary', args),
+    getDaily: (args: UsageRangeArgs) => call('getDaily', args),
+    getBreakdown: (args: UsageRangeArgs & { kind: string }) => call('getBreakdown', args),
+    getRecentSessions: (args: UsageRangeArgs & { limit?: number }) =>
+      call('getRecentSessions', args)
+  }
+}

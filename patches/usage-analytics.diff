+// Why: without these three keys the namespaces fell through to createFallbackProxy,
+// where every method resolves to undefined — so Stats & Usage stayed on "Not scanned
+// yet" and its enable buttons did nothing at all. The three desktop namespaces differ
+// only by channel prefix, so one factory carries the provider as a parameter rather
+// than repeating the same eight methods three times.
+// Why `never`: PreloadApi declares ClaudeUsageApi / CodexUsageApi / OpenCodeUsageApi
+// as three separate types whose payloads differ by name and, for scan state, by one
+// field — so no single annotation satisfies all three call sites. Same escape hatch
+// createAccountsApi already uses in this file for codexAccounts/claudeAccounts. The
+// wire contract is JSON either way: the runtime returns exactly what the desktop
+// store returns.
+function createUsageApi(provider: 'claude' | 'codex' | 'openCode'): never {
+  const call = (method: string, params: Record<string, unknown> = {}): Promise<unknown> =>
+    callRuntimeResult<unknown>(`usage.${method}`, { provider, ...params })
+  return {
+    getScanState: () => call('getScanState'),
+    setEnabled: (args: { enabled: boolean }) => call('setEnabled', { enabled: args.enabled }),
+    // Why: `force` is optional on the desktop signature and the schema rejects unknown
+    // keys, so omit it entirely rather than sending an explicit undefined.
+    refresh: (args?: { force?: boolean }) =>
+      call('refresh', args?.force === undefined ? {} : { force: args.force }),
+    getSnapshot: (args: UsageWindowArgs) => call('getSnapshot', pruneUsageWindow(args)),
+    getSummary: (args: UsageWindowArgs) =>
+      call('getSummary', { scope: args.scope, range: args.range }),
+    getDaily: (args: UsageWindowArgs) => call('getDaily', { scope: args.scope, range: args.range }),
+    getBreakdown: (args: UsageWindowArgs & { kind: string }) =>
+      call('getBreakdown', { scope: args.scope, range: args.range, kind: args.kind }),
+    getRecentSessions: (args: UsageWindowArgs) =>
+      call('getRecentSessions', pruneUsageWindow(args))
+  } as never
+}
+
+type UsageWindowArgs = { scope: string; range: string; limit?: number }
+
+function pruneUsageWindow(args: {
+  scope: string
+  range: string
+  limit?: number
+}): Record<string, unknown> {
+  return {
+    scope: args.scope,
+    range: args.range,
+    ...(args.limit === undefined ? {} : { limit: args.limit })
+  }
+}

+type WebActiveWorkspacePointer = Pick<
+  PersistedUIState,
+  'lastActiveRepoId' | 'lastActiveWorktreeId'
+>
+
+let rememberedActiveWorkspace: WebActiveWorkspacePointer | null = null
+
+/** Record the workspace getStoredWorkspaceSession restores from, in the host's ui slice.
+ *
+ *  Why: a paired browser keeps no session — sanitizeWebRuntimeWorkspaceSession drops it and the
+ *  tabs come back over session.tabs — so the only thing that has to survive a restart is which
+ *  workspace was open. Upstream already reads that back from ui.lastActive*, but nothing writes
+ *  it, so a restarted tile lands on the Landing screen with every worktree in the sidebar. */
+function rememberWebActiveWorkspace(
+  session: Partial<WorkspaceSessionState>,
+  hostId?: string | null
+): void {
+  // Why: these are global session fields — cloned onto every host slice, owned by 'local'.
+  if ((normalizeExecutionHostId(hostId) ?? LOCAL_EXECUTION_HOST_ID) !== LOCAL_EXECUTION_HOST_ID) {
+    return
+  }
+  if (!('activeRepoId' in session) && !('activeWorktreeId' in session)) {
+    return
+  }
+  // Why: `session.patch` carries only the keys that changed, so coercing an absent key to null
+  // would clear the other half of the pointer — switching worktree would erase the repo, and the
+  // restore path reads `ui.lastActiveRepoId ?? localSession.activeRepoId`, so it would find that
+  // null rather than fall through to the browser copy. Carry the unchanged half forward.
+  const known = rememberedActiveWorkspace ?? readLocalWebUIState()
+  const pointer: WebActiveWorkspacePointer = {
+    lastActiveRepoId:
+      'activeRepoId' in session ? (session.activeRepoId ?? null) : (known.lastActiveRepoId ?? null),
+    lastActiveWorktreeId:
+      'activeWorktreeId' in session
+        ? (session.activeWorktreeId ?? null)
+        : (known.lastActiveWorktreeId ?? null)
+  }
+  if (
+    rememberedActiveWorkspace?.lastActiveRepoId === pointer.lastActiveRepoId &&
+    rememberedActiveWorkspace.lastActiveWorktreeId === pointer.lastActiveWorktreeId
+  ) {
+    return
+  }
+  rememberedActiveWorkspace = pointer
+  writeJson(UI_STORAGE_KEY, mergeWebUIState(readLocalWebUIState(), pointer))
+  if (!requireActiveEnvironmentOrNull()) {
+    return
+  }
+  void callRuntimeResult('ui.set', pointer, 15_000).catch(() => {
+    // Why: an unreachable host must not break session persistence; drop the memo so the next write retries.
+    rememberedActiveWorkspace = null
+  })
+}
